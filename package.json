{
  "name": "lunamail",
  "version": "0.9.42",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node electron/dev.mjs",
    "dev:web": "vite",
    "build": "node scripts/build-frontend.mjs",
    "build:desktop": "node scripts/clean-installers.mjs && npm run build && electron-builder --win nsis --publish never",
    "build:desktop:publish": "node scripts/clean-installers.mjs && npm run build && electron-builder --win nsis --publish always",
    "preview": "vite preview",
    "start:release": "electron ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "electron-updater": "^6.8.9",
    "imapflow": "^1.0.181",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.7.4",
    "nodemailer": "^7.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^36.5.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.lunamail.app",
    "productName": "LunaMail",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src-tauri/icons/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src-tauri/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Emiciano",
      "repo": "LunaMail"
    }
  }
}
